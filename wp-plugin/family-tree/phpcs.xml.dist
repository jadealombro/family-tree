<?xml version="1.0"?>
<ruleset name="Family Tree">
	<description>WordPress Coding Standards for the Family Tree plugin.</description>

	<!-- What to check. -->
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<!-- How to run: show rule names, colours, progress. -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- The main rule set. -->
	<rule ref="WordPress"/>

	<!-- Catch code that would not run on the PHP versions we support. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Oldest WordPress we support; flags functions newer than this. -->
	<config name="minimum_wp_version" value="6.5"/>

	<!-- Every global name must start with one of these, so we never collide with other plugins. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="FamilyTree"/>
				<element value="family_tree"/>
				<element value="FAMILY_TREE"/>
			</property>
		</properties>
	</rule>

	<!-- Capabilities we define ourselves, so the sniff does not flag them as unknown. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_family_tree"/>
			</property>
		</properties>
	</rule>

	<!-- Strings shown to users must use this text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="family-tree"/>
			</property>
		</properties>
	</rule>
</ruleset>
